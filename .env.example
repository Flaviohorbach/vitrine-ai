# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: tracing with Langfuse (https://cloud.langfuse.com → project settings → API keys).
# Without them the app runs the same, untraced.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Shown as "Ver o trace" links under each answer. Find it in the project URL: /project/<id>/
LANGFUSE_PROJECT_ID=
